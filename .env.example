# Ces deux valeurs sont publiques par conception. Récupérez-les dans le panneau
# Connect de Supabase ou avec `npx supabase status` en local.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origine HTTPS publique propre à ce déploiement, sans slash final.
EXPO_PUBLIC_BUDGETIA_WEB_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Ne placez jamais de secret key ni de service_role dans une variable EXPO_PUBLIC_*.
