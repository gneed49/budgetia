{
  "expo": {
    "name": "Budgetia",
    "slug": "budgetia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "budgetia",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.budgetia.mobile"
    },
    "android": {
      "package": "com.budgetia.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBFCFB"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Budgetia",
      "shortName": "Budgetia",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#FBFCFB",
      "themeColor": "#169B68"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Budgetia à sélectionner une photo de ticket.",
          "cameraPermission": "Autoriser Budgetia à photographier un ticket.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBFCFB"
        }
      ]
    ]
  }
}
